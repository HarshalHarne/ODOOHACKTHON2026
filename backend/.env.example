# Server
PORT=8080

# PostgreSQL — used by the application (pgxpool) and goose migrations
DATABASE_URL=postgres://postgres:password@localhost:5432/assetflow?sslmode=disable

# Goose migration driver config
# These are read by goose when running: goose -dir sql/migrations postgres "$DATABASE_URL" up
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://postgres:password@localhost:5432/assetflow?sslmode=disable
GOOSE_MIGRATION_DIR=sql/migrations

# Auth
JWT_SECRET=change_me_to_a_long_random_secret_in_production
JWT_EXPIRY_HOURS=24
